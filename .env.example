# Nom du projet Docker Compose. Il fixe le nom du volume de la base : lapince_postgres_data.
# Sans lui, le nom vient du dossier du dépôt : un autre dossier = une autre base, vide.
COMPOSE_PROJECT_NAME=lapince

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_LOCAL_PORT=

# Longue chaîne aléatoire, par exemple : openssl rand -base64 48
JWT_SECRET=

# Mot de passe de l'utilisateur Redis lapince_app (compteurs du limiteur de tentatives).
# Obligatoire : sans lui, aucune commande docker compose ne démarre. Le générer : openssl rand -base64 32
# (16 caractères au moins, sans espace)
REDIS_PASSWORD=

NODE_ENV=development

# Comptes PostgreSQL (docs/base-de-donnees.md, « Comptes et droits »). POSTGRES_USER, superutilisateur,
# ne sert qu'à l'administration ; l'API ne s'y connecte pas.
# Mots de passe des rôles, lus par db/roles.sql à leur création. Deux valeurs différentes, générées par :
# openssl rand -hex 32   (32 caractères au moins, sans caractère à encoder dans une adresse)
LAPINCE_OWNER_PASSWORD=
LAPINCE_APP_PASSWORD=

# L'API en fonctionnement : rôle lapince_app (lit et écrit les données, ne modifie aucune table)
# DATABASE_URL=postgresql://lapince_app:<LAPINCE_APP_PASSWORD>@db:5432/<POSTGRES_DB>
DATABASE_URL=
# Migrations et seed, au démarrage de l'API : rôle lapince_owner (propriétaire du schéma)
# MIGRATION_DATABASE_URL=postgresql://lapince_owner:<LAPINCE_OWNER_PASSWORD>@db:5432/<POSTGRES_DB>
MIGRATION_DATABASE_URL=
# prisma migrate dev (création d'une migration) : base « shadow » lapince_shadow, rôle lapince_owner
SHADOW_DATABASE_URL=

# Base des tests d'intégration : les mêmes adresses, avec la base lapince_test
# (le nom doit contenir « _test » : les tests refusent de tourner sinon)
DATABASE_URL_TEST=
MIGRATION_DATABASE_URL_TEST=

API_PORT=3007
API_LOCAL_PORT=3007


CLIENT_LOCAL_PORT=8080


VITE_API_BASE_URL=http://localhost:3007
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Base de l'URL du lien de vérification envoyé par email
FRONTEND_URL=http://localhost:8080

# Identifiants SMTP Brevo (envoi des emails de vérification)
SMTP_USER=
SMTP_PASS=
