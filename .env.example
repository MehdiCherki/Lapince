# Nom du projet Docker Compose. Il fixe le nom du volume de la base : lapince_postgres_data.
# Sans lui, le nom vient du dossier du dépôt : un autre dossier = une autre base, vide.
COMPOSE_PROJECT_NAME=lapince

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_LOCAL_PORT=

# Longue chaîne aléatoire, par exemple : openssl rand -base64 48
JWT_SECRET=

NODE_ENV=development

DATABASE_URL=
# Base des tests d'intégration : même URL que DATABASE_URL, avec la base lapince_test
# (le nom doit contenir « _test » : les tests refusent de tourner sinon)
DATABASE_URL_TEST=

API_PORT=3007
API_LOCAL_PORT=3007


CLIENT_LOCAL_PORT=8080


VITE_API_BASE_URL=http://localhost:3007
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Base de l'URL du lien de vérification envoyé par email
FRONTEND_URL=http://localhost:8080

# Identifiants SMTP Brevo (envoi des emails de vérification)
SMTP_USER=
SMTP_PASS=
