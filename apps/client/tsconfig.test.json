{
  // Tests vérifiés par tsc (tsc -b, donc aussi npm run build) : un test mal typé fait échouer le build
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vitest/globals"]
  },
  // vite-env.d.ts : types de import.meta.env, utilisés par les services que les tests importent
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test",
    "src/vite-env.d.ts"
  ],
  "exclude": []
}
