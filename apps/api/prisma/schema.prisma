generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Convention de nommage en base (PostgreSQL) : tables au pluriel et colonnes en snake_case,
// clés étrangères <entité>_id, types énumérés en snake_case. Les noms côté code (champs Prisma,
// donc API) sont conservés : @map / @@map font la correspondance.
// Argent : DECIMAL(12, 2) (au centime près, sans erreur d'arrondi des nombres à virgule flottante).
enum PeriodType {
  weekly
  monthly
  custom

  @@map("period_type")
}
enum CategoryType {
  EXPENSE
  INCOME

  @@map("category_type")
}

model User {
  id         Int     @id @default(autoincrement())
  first_name String
  last_name  String
  email      String  @unique
  password   String
  photo      String?
  emailVerified   Boolean   @default(false) @map("email_verified")
  // Jetons : seul leur hash SHA-256 est stocké (le jeton en clair n'existe que dans l'email ou le cookie)
  emailVerificationTokenHash  String? @map("email_verification_token_hash")
  passwordResetTokenHash  String?   @unique @map("password_reset_token_hash")
  passwordResetExpiresAt  DateTime? @map("password_reset_expires_at")
  
  // Relations
  budgets       Budget[]
  alerts        Alert[]
  transactions  Transaction[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")
  expiresAt DateTime @map("expires_at")

  @@map("refresh_tokens")
}

model Category {
  id    Int          @id @default(autoincrement())
  name  String
  color String?
  icon  String?
  type  CategoryType

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  transactions Transaction[]
  budgets      Budget[]
  alerts       Alert[]

  @@unique([name])
  @@map("categories")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  description String?
  userId      Int      @map("user_id")
  categoryId  Int      @map("category_id")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  category Category  @relation(fields: [categoryId], references: [id])
  User     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@map("transactions")
}

model Budget {
  id           Int    @id @default(autoincrement())
  limit_amount Decimal    @db.Decimal(12, 2)
  period       PeriodType
  id_category  Int        @map("category_id")
  userId       Int        @map("user_id")

  // Relation avec l'utilisateur (un budget appartient à un utilisateur)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relation avec la catégorie (un budget concerne une catégorie)
  category Category @relation(fields: [id_category], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")

  @@unique([userId, id_category])
  @@index([userId])
  @@map("budgets")
}

model Alert {
  id             Int      @id @default(autoincrement())
  exceededAmount Decimal  @db.Decimal(12, 2) @map("exceeded_amount")
  isRead         Boolean  @default(false) @map("is_read")
  userId         Int      @map("user_id")
  categoryId     Int      @map("category_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("alerts")
}
